# API
VITE_API_URL=https://api2.mitienda.pe/api
VITE_API_TIMEOUT=30000

# La tienda y la sucursal NO se configuran aquí: el kiosko se activa desde su
# propia pantalla (/#/activar) con el usuario del panel de un encargado, y el
# API las deduce de la llave de dispositivo que recibe.

# Vuelve a la bienvenida tras este tiempo sin tocar la pantalla (ms)
VITE_INACTIVITY_TIMEOUT=90000

# Imagen de fondo de la bienvenida (opcional)
VITE_HERO_IMAGE=

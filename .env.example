# API Configuration
VITE_API_URL=https://api2.mitienda.pe/api
VITE_API_TIMEOUT=30000

# Multi-tenant Configuration
VITE_DEV_TENANT=altea.mitienda.pe
VITE_TENANT_ID=

# Kiosk Configuration
VITE_KIOSK_ID=KIOSK_001
VITE_STORE_ID=1
VITE_BRANCH_NAME=Miraflores

# Timeout Settings (in milliseconds)
VITE_INACTIVITY_TIMEOUT=45000
VITE_PAYMENT_TIMEOUT=120000
VITE_UPSELL_TIMEOUT=15000

# Feature Flags
VITE_ENABLE_UPSELLING=true
VITE_ENABLE_DARK_MODE=false
VITE_ENABLE_MULTI_LANGUAGE=true

# Cache Settings
VITE_CACHE_TTL=300000
VITE_IMAGE_CACHE_TTL=3600000

# Hardware Integration
VITE_HARDWARE_SERVICE_URL=http://localhost:3001
VITE_PRINTER_ENABLED=true
VITE_PINPAD_ENABLED=true

VITE_HERO_IMAGE=https://mi-cdn.com/kiosk-hero-burger.jpg